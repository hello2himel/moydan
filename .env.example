# ---------------------------------------------------------------------------
# Moydan configuration
#
# Copy to `.env` and fill in. Never commit a real `.env`.
# All variables below have safe development defaults except where noted.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
# Public base URL of the social application (used for cookie origin checks,
# share links, and CORS allow-lists).
APP_ORIGIN=http://localhost:5173
# Port the API server listens on.
API_PORT=8787
# Secret used to sign session cookies and signed preview/public asset URLs.
# REQUIRED in production. Generate with: openssl rand -hex 32
SESSION_SECRET=dev-only-insecure-session-secret-change-me
# Long-lived secret used to authenticate build-worker job delivery.
# REQUIRED in production. Generate with: openssl rand -hex 32
WORKER_JOB_SECRET=dev-only-insecure-worker-secret-change-me

# --- Database ---
# SQLite file used by the bundled driver.
DATABASE_URL=file:./var/moydan.db
# Set to "postgres" only after implementing/porting migrations; see docs/DEPLOYMENT.md
DATABASE_DRIVER=sqlite

# --- Object storage (S3 compatible) ---
# STORAGE_DRIVER=fs uses ./var/storage (development/tests only, not durable).
# STORAGE_DRIVER=s3 requires the variables below (R2, S3, MinIO, Garage...).
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./var/storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=moydan
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style addressing is required by MinIO/Garage, optional on AWS S3/R2.
S3_FORCE_PATH_STYLE=true

# --- Public origins for game content ---
# Origin that serves immutable release artifacts and the sandboxed runtime.
# MUST be a different origin than APP_ORIGIN in production.
GAME_ORIGIN=http://localhost:5174
GAME_ORIGIN_PORT=5174
# CDN base URL that fronts GAME_ORIGIN in production. Empty = use GAME_ORIGIN.
CDN_BASE_URL=
# Allow-list of origins permitted to frame game content (the app origin).
# Comma separated. Defaults to APP_ORIGIN.
GAME_FRAME_ANCESTORS=

# --- Build workers ---
# Worker polling interval (ms) and lease duration for claimed jobs.
WORKER_POLL_MS=500
BUILD_JOB_LEASE_SECONDS=300
# Hard wall-clock limit for a single build (ms).
BUILD_TIMEOUT_MS=120000
# Memory limit handed to the isolated build child process (MB).
BUILD_MEMORY_MB=768
# Filesystem workspace root for builds. Use a tmpfs in production.
BUILD_WORKSPACE_ROOT=./var/builds
# Local directory containing the pinned, pre-vendored toolchain (esbuild,
# phaser). Populated by `npm run vendor:toolchain`. Builds never hit the network.
BUILD_TOOLCHAIN_DIR=./vendor/toolchain
# Optional container isolation. When 1 and Docker is present, builds execute
# inside `docker run --network=none` instead of a child process.
BUILD_USE_DOCKER=0
BUILD_CONTAINER_IMAGE=node:22-alpine

# --- Quotas & limits (documented in docs/PROJECT-FORMAT.md) ---
QUOTA_USER_SOURCE_BYTES=52428800
QUOTA_USER_RELEASE_BYTES=104857600
MAX_FILE_BYTES=4194304
MAX_PROJECT_FILES=400
MAX_SOURCE_BYTES=20971520
MAX_ARCHIVE_BYTES=16777216
MAX_ARCHIVE_EXPANDED_BYTES=67108864
MAX_ARCHIVE_RATIO=100
MAX_ARTIFACT_BYTES=25165824
MAX_FIRST_PLAYABLE_BYTES=4194304
MAX_BUILD_JOBS_PER_DAY=50
MAX_UPLOADS_PER_HOUR=120

# --- Rate limits (requests / minute) ---
RATE_LIMIT_DEFAULT_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_WRITE_PER_MIN=120
RATE_LIMIT_UPLOAD_PER_MIN=30

# --- Moderation ---
# Comma separated emails that are promoted to admin on registration in dev.
ADMIN_EMAILS=
