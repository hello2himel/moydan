dist/
var/
*.log
.env
.env.local
.DS_Store
coverage/
playwright-report/
test-results/

# Generated toolchain (esbuild/phaser pins) - recreated by `npm run vendor:toolchain`.
vendor/toolchain/
*.tsbuildinfo

# Desktop (Tauri) build output and the staged resource bundle (Node runtime,
# bundled servers, web build). Both are produced by `node scripts/build-desktop.mjs`.
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/resources/
apps/desktop/dist/
apps/desktop/release/

# Android build output.
apps/android/build/
apps/android/app/build/
apps/android/.gradle/
apps/android/local.properties
apps/android/keystore/

# Release artefacts.
dist-release/
dist-flatpak/
.flatpak-build/
.flatpak-repo/

# Signing material must never be committed.
*.jks
*.keystore
*.p12

# Tauri generated permission schemas (recreated by cargo build).
apps/desktop/src-tauri/gen/schemas/
