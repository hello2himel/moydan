{
  "name": "moydan",
  "private": true,
  "version": "0.1.0",
  "description": "Moydan - an open-source social platform for short, immediately playable browser games",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:core && npm run build:runtime && npm run build:web",
    "build:core": "npm run build -w @moydan/core",
    "build:runtime": "npm run build -w @moydan/runtime",
    "build:web": "npm run build -w @moydan/web",
    "migrate": "npm run migrate -w @moydan/api",
    "seed": "npm run seed -w @moydan/api",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "npm run test:e2e -w @moydan/web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "gc": "npm run gc -w @moydan/api",
    "vendor:toolchain": "node scripts/vendor-toolchain.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
